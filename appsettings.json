{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,

    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1h",
        //"Period": "1m",
        "Limit": 5
      }
    ]
  }
}